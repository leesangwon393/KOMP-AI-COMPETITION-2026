{
  "schema_version": 2,
  "id": "B",
  "description": "R022 recipe baseline: ResNet101 Context448, central224, bilinear",
  "model": {
    "backbone": "resnet101",
    "decoder": "unet",
    "upsampling": "bilinear",
    "hf": false,
    "cross": "none",
    "dilation": "none",
    "weighted_skip": false,
    "hybrid": "none",
    "mamba_blocks": 0,
    "initialization": "imagenet"
  },
  "normalization": {
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "train": {
    "epochs": 150,
    "seed": 42,
    "patch": 448,
    "target": 224,
    "stride": 112,
    "samples_per_epoch": 420,
    "batch_size": 4,
    "workers": 0,
    "lr": 0.0003,
    "weight_decay": 0.0001,
    "rare_fraction": 0.1,
    "enriched_probability": 0.5,
    "rare_classes": [
      1,
      2
    ],
    "brightness_contrast_probability": 0.5,
    "gamma_probability": 0.3,
    "noise_probability": 0.15,
    "precision": "fp32",
    "deterministic": false
  },
  "loss": {
    "ce_weight": 0.5,
    "dice_weight": 0.25,
    "lovasz_weight": 0.25,
    "class_weights": [
      1,
      1,
      2,
      1
    ]
  },
  "evaluation": {
    "batch_size": 4,
    "absent": "one",
    "final_d4": true
  },
  "ssl": {
    "epochs": 50,
    "patch": 224,
    "batch_size": 32,
    "steps_per_epoch": 70,
    "lr": 0.0003,
    "weight_decay": 0.0001,
    "temperature": 0.07,
    "projection_width": 512,
    "embedding_width": 128
  }
}
